<!DOCTYPE html>
<html>
<head>
  <title>Students</title>
</head>
<body>

  <h2>Student List</h2>

  <a href="/create">Add Student</a>

  <ul>
    <% students.forEach(student => { %>
      <li>
        <%= student.name %>

        <a href="/update/<%= student.id %>">Edit</a>
        <a href="/remove/<%= student.id %>">Delete</a>
      </li>
    <% }) %>
  </ul>

</body>
</html>